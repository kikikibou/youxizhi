{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 《大国小国》房间服务器：一个 Durable Object 就是一个房间。
  "name": "dgxg",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  // 部署到拥有 yxzzxy.com 的账号（kougen1999）。写死在这里：本机登录的账号能看到它就部署到它，
  // 看不到时直接报错，不会部署到别的账号。
  "account_id": "83052ed0cde1cf2042578364bf32a5da",
  // 线上地址。workers.dev 在国内打不开，所以挂在自己的域名上。
  "routes": [{ "pattern": "api.yxzzxy.com", "custom_domain": true }],
  // AI 裁判用的模型（OpenRouter 的模型名）。API key 是密钥，不写在这里：npm run secret:judge
  "vars": { "JUDGE_MODEL": "anthropic/claude-opus-5.5" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
