{
  // 《大国小国》的 TypeScript 设置。只做类型检查（npm run typecheck），
  // 打包交给 Vite（网页）和 Wrangler（服务器）。
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["**/*.ts"],
  // 服务器和手机页面有各自的设置（运行时类型不同），见 server/、client/ 下的 tsconfig.json。
  "exclude": ["server/**", "client/**"]
}
